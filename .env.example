# ==============================================================================
# NEXGEN C2C SKILLS - PRODUCTION ENVIRONMENT CONFIGURATION
# (Copy this to .env for local/Hostinger or set in Hostinger / Vercel Dashboard)
# ==============================================================================

# 1. Admin Master Credentials (Only this email can access admin panel)
ADMIN_EMAIL=your-admin-email@gmail.com
ADMIN_PASSWORD=YourSecurePassword2026!

# 2. JWT Session Security Secret (Set any random long string)
JWT_SECRET=nexgen_super_secret_production_key_98237482347

# 3. Two-Factor Authentication (2FA) Email Setup (Gmail SMTP / Hostinger Webmail)
# Option A: Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-admin-email@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
EMAIL_FROM="NexGen Security" <your-admin-email@gmail.com>

# Option B: Hostinger Titan Webmail (Alternative)
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=admin@yourcustomdomain.com
# SMTP_PASS=YourEmailPasswordHere
# EMAIL_FROM="NexGen Admin" <admin@yourcustomdomain.com>

# Server Port (Optional, defaults to 3000 or Hostinger provided PORT)
PORT=3000
